<Page x:Class="FamilyTreeApp.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="首页" Background="#F5F1EB">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 页面标题 -->
        <TextBlock Grid.Row="0" Text="族谱管理系统" 
           FontSize="34" FontWeight="Bold" FontFamily="STSong" 
           Foreground="#2C2217" 
           HorizontalAlignment="Center" 
           Margin="0,20,0,0"/>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="1" x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="MainScroll_ScrollChanged">
            <StackPanel>

                <!-- 欢迎区域 -->
                <TextBlock Text="欢迎回来 管理与探索您的家族脉络" FontSize="16"
                           Foreground="#8A7E72" HorizontalAlignment="Center"/>

                <!-- 分割线 -->
                <Border Height="1" Background="#E0D6CA" Margin="0,5,0,10"/>

                <!-- 我创建的族谱 -->
                <TextBlock Text="我创建的族谱" FontSize="18" FontWeight="SemiBold"
                           Foreground="#2C2217" Margin="60,0,0,10"/>

                <Border x:Name="CreatedPanel" MaxHeight="232" ClipToBounds="True" Margin="60,0,0,0">
                    <WrapPanel x:Name="CreatedWrapPanel" Orientation="Horizontal"/>
                </Border>

                <TextBlock x:Name="CreatedExpandBtn" Text="展开更多  ▾"
                           Foreground="#B8653A" FontSize="13" Cursor="Hand"
                           Margin="60,0,0,10" Visibility="Collapsed"
                           MouseLeftButtonDown="CreatedExpand_Click"/>

                <!-- 间隔 -->
                <Border Height="1" Background="#E0D6CA" Margin="0,5,0,10"/>

                <!-- 我管理的族谱 -->
                <TextBlock Text="我管理的族谱" FontSize="18" FontWeight="SemiBold"
                           Foreground="#2C2217" Margin="60,0,0,10"/>

                <Border x:Name="ManagedPanel" MaxHeight="232" ClipToBounds="True" Margin="60,0,0,0">
                    <WrapPanel x:Name="ManagedWrapPanel" Orientation="Horizontal"/>
                </Border>

                <TextBlock x:Name="ManagedExpandBtn" Text="展开更多  ▾"
                           Foreground="#B8653A" FontSize="13" Cursor="Hand"
                           Margin="60,0,0,16" Visibility="Collapsed"
                           MouseLeftButtonDown="ManagedExpand_Click"/>

            </StackPanel>
        </ScrollViewer>

        <!-- 族谱信息弹窗 -->
        <Popup x:Name="ClanInfoPopup" StaysOpen="True" Placement="Bottom"
       AllowsTransparency="True" PopupAnimation="Fade"
       VerticalOffset="6">
            <!-- 外层 Border：仅用于承载阴影，避免与内层圆角冲突产生黑边 -->
            <Border Margin="0,0,0,8" Background="Transparent">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="28"
                              Opacity="0.18" Color="#1A1714"/>
                </Border.Effect>
                <!-- 内层 Border：负责背景色和圆角 -->
                <Border x:Name="PopupInnerBorder" Width="300" Background="#FFFFFF" 
                CornerRadius="14" Padding="28,24">
                    <StackPanel x:Name="PopupContentPanel"/>
                </Border>
            </Border>
        </Popup>
    </Grid>
</Page>
