<Window x:Class="FamilyTreeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Background="#F5F1EB"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        ResizeMode="CanResizeWithGrip"
        MinWidth="400" MinHeight="400">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部导航栏 -->
        <Border Grid.Row="0" Background="#1A1714" BorderThickness="0,0,0,1"
                BorderBrush="#2A2318">
            <Grid Margin="48,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="NavHome" Content="首页"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Visibility="Collapsed"
                                 Checked="Nav_Checked" Tag="Home"/>
                    <RadioButton x:Name="NavClan" Content="族谱管理"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 Visibility="Collapsed"
                                 Checked="Nav_Checked" Tag="Clan"/>
                </StackPanel>
                <Button x:Name="LogoutButton" Content="退出登录"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="LogoutButton_Click"
                        Background="Transparent" Foreground="#A89880"
                        BorderThickness="0" Cursor="Hand" FontSize="13" Padding="16,12"/>
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
